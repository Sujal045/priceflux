# Copy to repo root as `.env` for local development (never commit `.env`).
# Used by `infra/docker-compose.yml` and later by apps.

# --- Postgres ---
POSTGRES_USER=priceflux
POSTGRES_PASSWORD=priceflux
POSTGRES_DB=priceflux
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://priceflux:priceflux@localhost:5433/priceflux

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_USER=priceflux
RABBITMQ_PASSWORD=priceflux
RABBITMQ_VHOST=priceflux
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://priceflux:priceflux@localhost:5672/priceflux

# --- API ---
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- Workers ---
WORKER_SCRAPER_PREFETCH=5
WORKER_SCRAPER_HEADLESS=true
WORKER_SCRAPER_NAVIGATION_TIMEOUT_MS=30000
WORKER_SCRAPER_METRICS_PORT=9101
# Anti-bot baseline (stage 16) — leave off for local JSON-LD fixtures
SCRAPER_STEALTH=false
# SCRAPER_PROXY_URL=http://user:pass@proxy.example:8080
SCRAPER_DOMAIN_RATE_LIMIT=30
SCRAPER_DOMAIN_RATE_WINDOW_SECONDS=60
WORKER_NOTIFIER_PREFETCH=10
WORKER_NOTIFIER_METRICS_PORT=9102
# Optional: POST drop-alert JSON here (log stub always runs)
# NOTIFIER_WEBHOOK_URL=https://hooks.example/priceflux

# --- Mailpit (local SMTP inbox for notifier email) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_UI_URL=http://127.0.0.1:8025
# Leave NOTIFIER_SMTP_HOST unset to disable email (log ± webhook only).
# For local Mailpit, uncomment:
# NOTIFIER_SMTP_HOST=127.0.0.1
# NOTIFIER_SMTP_PORT=1025
# NOTIFIER_SMTP_FROM=priceflux@localhost
# NOTIFIER_SMTP_SECURE=false
# NOTIFIER_SMTP_REQUIRE_TLS=false
# NOTIFIER_SMTP_USER=
# NOTIFIER_SMTP_PASS=
