{
  "name": "@priceflux/mq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config ../../eslint.config.js src --max-warnings=0",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "PRICEFLUX_MQ_INTEGRATION=1 node --env-file=../../.env --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@priceflux/shared": "workspace:*",
    "amqplib": "^0.10.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
